# ============================================================================
# NSXDC Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# Anthropic API Configuration
# ============================================================================
ANTHROPIC_API_KEY=your_api_key_here
MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TEMPERATURE=0.0

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3002
NODE_ENV=development
HOST=localhost

# ============================================================================
# Feature Flags (ALWAYS ON - Do not disable)
# ============================================================================
ENABLE_CACHING=true
FORCE_VALIDATED_MODE=true
FORCE_VALIDATION=true

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=20m

# ============================================================================
# Week 1 Features
# ============================================================================

# Date Preprocessing (Day 2)
ENABLE_DATE_PREPROCESSING=true

# Request Validation & Middleware (Day 4)
ENABLE_REQUEST_VALIDATION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# API Key Authentication (Optional - Day 4)
# Set to 'true' to enable API key validation
API_KEY_ENABLED=false
# Comma-separated list of valid API keys (or use API_KEY for single key)
API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3
# Alternative: Single API key
# API_KEY=your_single_api_key
# Custom header name for API key (default: x-api-key)
API_KEY_HEADER=x-api-key

# ============================================================================
# Week 2 Features - Storage & Caching
# ============================================================================

# Storage Configuration
STORAGE_TYPE=file
STORAGE_PATH=./data/extractions

# PostgreSQL (production - optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/nsxdc
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Cache Configuration
CACHE_TYPE=memory
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100

# Redis (production - optional)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================================================
# Week 3 Features - Medical Intelligence
# ============================================================================

# Medical Terminology Standardization
ENABLE_TERMINOLOGY_STANDARDIZATION=true
ENABLE_CODE_MAPPING=true

# Confidence Calibration
ENABLE_CONFIDENCE_CALIBRATION=true
CONFIDENCE_THRESHOLD_ACCEPT=0.85
CONFIDENCE_THRESHOLD_REVIEW=0.70

# ============================================================================
# Week 4 Features - Multi-Model Consensus
# ============================================================================

# Consensus for critical fields
ENABLE_CONSENSUS=false
CONSENSUS_PASSES=3
CONSENSUS_TEMPERATURES=0.0,0.3,0.5

# Enhanced Narratives
NARRATIVE_MODE=ENHANCED
ENABLE_CLINICAL_REASONING=true

# ============================================================================
# Week 5 Features - Production Hardening
# ============================================================================

# Data Anonymization
ENABLE_ANONYMIZATION=false
ANONYMIZATION_KEY=your_secret_key_for_reversible_anonymization

# Batch Processing
BATCH_MAX_WORKERS=3
BATCH_RETRY_FAILURES=true
BATCH_TIMEOUT_SECONDS=300

# Audit Trail
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=./data/audit

# ============================================================================
# Week 6 Features - API Excellence
# ============================================================================

# API Authentication (optional)
ENABLE_API_AUTH=false
# API_KEYS=key1,key2,key3

# Rate Limiting Tiers
RATE_LIMIT_TIER=free
# Tiers: free (10/day), pro (100/day), enterprise (unlimited)

# Webhooks
ENABLE_WEBHOOKS=false
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3

# ============================================================================
# Security & Compliance
# ============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3002
CORS_CREDENTIALS=true

# Security Headers (Helmet)
ENABLE_HELMET=true

# ============================================================================
# Development & Testing
# ============================================================================

# Testing
TEST_MODE=false
TEST_MOCK_LLM=false

# Performance Monitoring
ENABLE_PERFORMANCE_TRACKING=true

# Debug Options
DEBUG=false
VERBOSE_LOGGING=false

# ============================================================================
# Production Settings (Week 8)
# ============================================================================

# High Availability
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL_MS=30000

# Monitoring (optional)
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Automated Backups
AUTO_BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# Frontend Environment Variables (create frontend/.env from frontend/.env.example)
# ============================================================================

# These should be set in frontend/.env (not here):
# VITE_API_KEY=your-api-key-here
# VITE_API_BASE_URL=http://localhost:3002

# ============================================================================
# Cost Management
# ============================================================================

# Token Usage Tracking
TRACK_TOKEN_USAGE=true
MAX_MONTHLY_TOKENS=1000000
ALERT_TOKEN_THRESHOLD=0.8

# Cost Alerts (optional)
# ALERT_EMAIL=
# DAILY_COST_LIMIT=50.00
